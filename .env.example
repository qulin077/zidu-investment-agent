# LLM (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=
LLM_REASONING_EFFORT=

# Expensive cross-source synthesis can use a stronger model while planning and
# per-source reading remain on LLM_MODEL. Current DeepSeek production choice:
# deepseek-v4-pro with high/max reasoning.
RESEARCH_LLM_MODEL=deepseek-v4-pro
RESEARCH_LLM_REASONING_EFFORT=high

# iFinD MCP. Prefer a deployment secret; never commit the real token.
IFIND_MCP_TOKEN=
# Local Codex development only: discover ~/.codex/skills/ifind-finance-data/mcp_config.json
SA_ENABLE_IFIND=0
# Cost controls: public/free sources are the default. Enable only when wanted.
SA_ENABLE_IFIND_RESEARCH=0
SA_IFIND_MARKET_PRIORITY=free

# Deployment. Keep personal/runtime data outside the source tree in production.
SA_DB_PATH=
SA_HTTP_CACHE=
SA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8787
# Competition/demo mode keeps the public journey focused on Agent → Research → Review.
NEXT_PUBLIC_DEMO_MODE=0
